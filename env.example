# Obligatorio
DISCORD_TOKEN=TU_TOKEN_DEL_BOT

# Recomendado para que los comandos aparezcan instantáneo en tu servidor
GUILD_ID=ID_DE_TU_SERVIDOR

# Marca / decoración
BOT_NAME=JUANPLAY
BOT_BRAND=DEVJUANCHO • JuanStudio
BOT_COLOR=#ff2f7d
SUCCESS_COLOR=#2ecc71
WARNING_COLOR=#f1c40f
ERROR_COLOR=#ff2f7d

# Público / anti-spam
COMMAND_COOLDOWN_MS=2500
ANNOUNCE_NOW_PLAYING=false
MAX_QUEUE_SIZE=500
QUEUE_ITEMS_PER_PAGE=10

# Música / voz
VOICE_TIMEOUT_MS=120000
VOICE_SELF_DEAF=true
DEFAULT_VOLUME=85
MAX_PLAYLIST_ITEMS=25

# Opcional: enlaces públicos para /invite
BOT_INVITE_URL=
SUPPORT_SERVER=
WEBSITE_URL=

# Opcional: necesario si YouTube dice 429 o "Sign in to confirm you’re not a bot" en Railway
# Pega aquí cookies de YouTube en formato Header o Netscape. Mejor usa una cuenta secundaria.
YOUTUBE_COOKIE=

# Alternativa: cookies en base64 si Railway te rompe los saltos de línea
YOUTUBE_COOKIE_BASE64=
