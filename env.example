# OBLIGATORIO
DISCORD_TOKEN=PEGA_AQUI_EL_TOKEN_DEL_BOT
GUILD_ID=ID_DE_TU_SERVIDOR

# RECOMENDADO PARA YOUTUBE EN HOSTINGS COMO RAILWAY
# Usa una cuenta secundaria. NO compartas esta cookie.
YOUTUBE_COOKIE=

# AJUSTES
VOICE_TIMEOUT_MS=120000
VOICE_SELF_DEAF=true
DEFAULT_VOLUME=85
MAX_PLAYLIST_ITEMS=25
BOT_COLOR=#ff2f7d

# OPCIONAL: si usas yt-dlp instalado manualmente
# YOUTUBE_DL_DIR=
# YOUTUBE_DL_FILENAME=
