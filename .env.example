# Token de tu bot desde Discord Developer Portal
DISCORD_TOKEN=PEGA_TU_TOKEN_AQUI

# ID de la aplicación/bot desde Discord Developer Portal
CLIENT_ID=PEGA_EL_CLIENT_ID_AQUI

# Opcional: ID de tu servidor para registrar comandos rápido mientras pruebas.
# Déjalo vacío para comandos globales en todos los servidores donde esté el bot.
GUILD_ID=

# true = registra los slash commands automáticamente al iniciar.
AUTO_DEPLOY_COMMANDS=true

# Opcional: texto que sale en /embed ayuda
BOT_BRAND=Embed Studio
