# Nunca subas tu .env real a GitHub.
DISCORD_TOKEN=pon_tu_token_aqui
CLIENT_ID=id_de_tu_aplicacion

# Railway MongoDB normalmente te da esta variable como MONGO_URL.
MONGO_URL=mongodb://usuario:password@host:puerto/database

# Opcional: para probar comandos al instante en un servidor específico.
GUILD_ID=id_de_tu_servidor

# Opcional: si quieres que Railway registre comandos al iniciar.
AUTO_DEPLOY_COMMANDS=false

# Railway asigna PORT automáticamente. Localmente puedes usar 3000.
PORT=3000
